# Copy to .env and fill in your keys (never commit .env).

OPENAI_API_KEY=your_openai_api_key_here
# Optional: default gpt-4o. Use gpt-4o-mini during dev if you hit TPM rate limits (429).
# OPENAI_MODEL=gpt-4o
# OPENAI_MAX_RETRIES=8

# Optional: enables persistent runs, logs, timeline, and auth sessions. Use a
# Neon Postgres URL with sslmode=require. The pooled URL is preferred for app traffic.
# DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require
# Optional unpooled URL for schema/DDL operations.
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Optional: LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key_here
# LANGCHAIN_PROJECT=insight-ai-agent

# Saved browser sessions for authenticated tests. The database stores encrypted
# cookies and localStorage, not the password. Generate a key with:
#   uv run python -m insightai.auth.capture generate-key
# AUTH_DATABASE_URL defaults to DATABASE_URL when unset. Remote hosts need
# sslmode=require (Neon) or verify-full. The key stays in this file, not in the DB.
# AUTH_DATABASE_URL=postgresql://insight_auth:password@db-host:5432/insight_auth?sslmode=require
# AUTH_DATA_KEY=
# AUTH_SESSION_TTL_MINUTES=60

# Neon Object Storage for this branch (from `neon link` / `neon deploy` / `neon env pull`).
# Names look like AWS because Neon is S3-compatible; the endpoint is Neon, not Amazon S3.
# Missing values skip screenshot/video upload without failing the QA run.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_ENDPOINT_URL_S3=
# AWS_REGION=us-east-2

# Playwright MCP (required for browser steps). Default is local; on hosted / sidecar
# deployments point at the reachable MCP HTTP URL. INSIGHT_MEDIA_DIR must match the
# MCP process --output-dir (default: .playwright-mcp). Absolute path recommended.
# PLAYWRIGHT_MCP_URL=http://localhost:8931/mcp
# INSIGHT_MEDIA_DIR=.playwright-mcp
# INSIGHT_AUTH_SCRATCH_DIR=.playwright-mcp/auth

# Browser safety bounds. Hosted runs reject non-public DNS/IP results and custom
# ports unless the exact host is explicitly configured as a local target.
# Add comma-separated exact hostnames for authorized public staging targets.
# Local targets must be explicit (including a development port when needed).
# INSIGHT_ALLOWED_TARGET_HOSTS=staging.example.com
# INSIGHT_LOCAL_TARGETS=localhost,127.0.0.1,::1
# Run timeout defaults to 15 minutes (maximum 60); each MCP tool call defaults
# to 60 seconds (maximum 300); local evidence defaults to 512 MiB per run.
# INSIGHT_TOOL_TIMEOUT_SECONDS=60
# INSIGHT_MAX_RUN_MEDIA_MB=512
# INSIGHT_MEDIA_RETENTION_SECONDS=3600
